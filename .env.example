# Souvenir AI - environment variables

# --- Pipeline ---
# Force le mode IA: lite | basic | replicate | advanced  (auto-detect par defaut)
# replicate = GPU serverless (recommande pour Vercel + effet wow)
PIPELINE_MODE=replicate
MAX_UPLOAD_MB=10

# --- Replicate (GPU serverless, ~$0.005-0.01/image) ---
# Token sur https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxx
REPLICATE_FIDELITY=0.7
REPLICATE_UPSCALE=2

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # Settings > API > service_role (SECRET, server only)
SUPABASE_BUCKET=souvenir

# --- CORS (separe par virgule) ---
CORS_ORIGINS=*

# --- Quota & Monetisation ---
DAILY_FREE_LIMIT=3
# Cap global anti-abus : 0 = desactive, sinon plafond du nombre total de
# restaurations gratuites par 24h (toutes confondues). Empeche un attaquant
# de cycler des device_id pour drainer le credit Replicate.
DAILY_GLOBAL_LIMIT=0
# Active le header X-Premium=1 cote client (UNIQUEMENT pour dev/tests).
# En prod laisser a 0 : le statut premium vient de la table subscriptions.
DEV_ALLOW_PREMIUM_HEADER=0
# Cle anon publique Supabase (pour valider les JWT cote serveur)
SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Paiement GeniusPay (Mobile Money / Cartes XOF) ---
# Dashboard : https://pay.genius.ci/dashboard
GENIUSPAY_API_KEY=pk_sandbox_xxxxxxxx              # X-API-Key (publique)
GENIUSPAY_API_SECRET=sk_sandbox_xxxxxxxx           # X-API-Secret (SECRET, server only)
GENIUSPAY_WEBHOOK_SECRET=whsec_xxxxxxxx            # secret du webhook (HMAC SHA256)
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
# Catalogue de packs (override le default si defini)
# JSON inline. Default : 3 packs hebdomadaires (10/50/100 photos).
# Ne pas mettre en prod sauf si tu veux modifier les prix.
# PACK_CATALOG_JSON={"pack_10_week":{"images":10,"price":1499,"days":7,"label":"10 photos / semaine"},...}
# Rate-limit anti-spam : nombre max de paiements crees par device/user en 10 min
PAYMENTS_RATE_LIMIT_PER_10MIN=5
# Plafond mensuel pour utilisateurs PREMIUM legacy (sub illimite sans pack_size).
# 0 = illimite. 100 = ~4 USD/mois max de cout Replicate par premium.
# Sans effet pour les nouveaux packs hebdo (le pack_size limite naturellement).
PREMIUM_MONTHLY_LIMIT=100

# --- Monitoring & observabilite ---
# Token admin pour /api/admin/stats (min 16 chars, generer avec: openssl rand -hex 32)
ADMIN_TOKEN=changeme_use_at_least_32_random_chars
# Webhook Discord/Slack pour alertes critiques (signature webhook invalide,
# fraude detectee, AI failures, nouveaux paiements). Vide = desactive.
ADMIN_WEBHOOK_URL=
# Sentry DSN (optionnel). Vide = desactive. Active error tracking + perf.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_NAME=Souvenir AI

# --- Apple In-App Purchase (StoreKit) ---
# Bundle ID iOS de l'app (verification anti-receipt-injection)
APPLE_BUNDLE_ID=ci.cleanphoto.souvenirai
# Active/desactive l'endpoint /api/payments/apple/verify (1=on, 0=off)
APPLE_IAP_ENABLED=1
# Force l'utilisation du serveur sandbox Apple (DEV/STAGING UNIQUEMENT).
# En prod, laisser a 0 : le backend fallback automatiquement sur sandbox
# si Apple retourne le code 21007.
APPLE_USE_SANDBOX=0
# Shared secret App Store Connect (UNIQUEMENT pour subscriptions auto-renouvelables).
# Pour des Consumables (nos packs), laisser vide.
APPLE_SHARED_SECRET=
