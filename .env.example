# Souvenir AI - environment variables

# --- Pipeline ---
# Force le mode IA: lite | basic | replicate | advanced  (auto-detect par defaut)
# replicate = GPU serverless (recommande pour Vercel + effet wow)
PIPELINE_MODE=replicate
MAX_UPLOAD_MB=10

# --- Replicate (GPU serverless, ~$0.005-0.01/image) ---
# Token sur https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxx
REPLICATE_FIDELITY=0.7
REPLICATE_UPSCALE=2

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # Settings > API > service_role (SECRET, server only)
SUPABASE_BUCKET=souvenir

# --- CORS (separe par virgule) ---
CORS_ORIGINS=*

# --- Quota & Monetisation ---
DAILY_FREE_LIMIT=3
# Cap global anti-abus : 0 = desactive, sinon plafond du nombre total de
# restaurations gratuites par 24h (toutes confondues). Empeche un attaquant
# de cycler des device_id pour drainer le credit Replicate.
DAILY_GLOBAL_LIMIT=0
# Active le header X-Premium=1 cote client (UNIQUEMENT pour dev/tests).
# En prod laisser a 0 : le statut premium vient de la table subscriptions.
DEV_ALLOW_PREMIUM_HEADER=0
# Cle anon publique Supabase (pour valider les JWT cote serveur)
SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Paiement GeniusPay (Mobile Money / Cartes XOF) ---
# Dashboard : https://pay.genius.ci/dashboard
GENIUSPAY_API_KEY=pk_sandbox_xxxxxxxx              # X-API-Key (publique)
GENIUSPAY_API_SECRET=sk_sandbox_xxxxxxxx           # X-API-Secret (SECRET, server only)
GENIUSPAY_WEBHOOK_SECRET=whsec_xxxxxxxx            # secret du webhook (HMAC SHA256)
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
# Tarif premium en F CFA (XOF, unite directe)
PREMIUM_PRICE_XOF=2999
# Plan par defaut : 'monthly' (renouvellement manuel) ou 'lifetime' (a vie)
PREMIUM_PLAN=monthly
# Duree d'un plan mensuel (jours)
PREMIUM_DURATION_DAYS=30
